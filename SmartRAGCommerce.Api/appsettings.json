{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SmartRAGCommerceDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SmartRAG": {
    "DatabaseConnections": [
      {
        "Name": "SmartRAGCommerce",
        "DatabaseType": "SqlServer"
      }
    ],
    "Features": {
      "EnableFileWatcher": false,
      "EnableMcpSearch": false
    },
    "DefaultLanguage": "en"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatEndpoint": "/v1/chat/completions",
    "Model": "qwen2.5-coder:7b",
    "EmbeddingModel": "all-minilm:latest",
    "EmbeddingEndpoint": "/api/embed",
    "TimeoutSeconds": 600,
    "BatchSize": 32
  },
  "AI": {
    "Custom": {
      "ApiKey": "not-required",
      "Endpoint": "http://localhost:11434/v1/chat/completions",
      "Model": "qwen2.5-coder:7b",
      "EmbeddingModel": "all-minilm:latest",
      "EmbeddingEndpoint": "http://localhost:11434/api/embed"
    }
  },
  "Storage": {
    "Qdrant": {
      "Host": "localhost",
      "UseHttps": false,
      "ApiKey": "",
      "CollectionName": "SmartRAGCommerce_Knowledge",
      "VectorSize": 384,
      "DistanceMetric": "Cosine"
    }
  },
  "AllowedHosts": "*"
}
